#include <vector>
#include <iostream>

std::vector<int> countPositivesSumNegatives(std::vector<int> input){
  int poscount = 0;
  int negsum = 0;
  
  if (!input.empty()) {
    for (int i=0; i < input.size(); i++) {
      if (input[i] > 0){
        poscount += 1;
      } else {
        negsum += input[i];
      }
    }
  } else {
    return {};
  }
  
  return {poscount, negsum};
}


// New solution 

#include <vector>

std::vector<int> countPositivesSumNegatives(std::vector<int> input){
  int posCount {0}, negSum {0};
  
  if (input.empty()) {return {};}
  for (int x: input) {
    x > 0 ? posCount++ : negSum += x;
  }
  
  return {posCount, negSum};
}
